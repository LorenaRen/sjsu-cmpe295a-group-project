<?xml version="1.0"?>
<!--
  Static person for mrs_sim (Module 2). Rendered by mrs_sim.actor_model.actor_sdf(); do not spawn
  this file directly. A body cylinder the LiDAR sees (it scans at about 0.18 m) plus a head.
-->
<sdf version="1.9">
  <model name="$name">
    <static>true</static>
    <link name="link">
      <collision name="body_collision">
        <pose>0 0 $body_z 0 0 0</pose>
        <geometry><cylinder><radius>$radius</radius><length>$body_height</length></cylinder></geometry>
      </collision>
      <visual name="body_visual">
        <pose>0 0 $body_z 0 0 0</pose>
        <geometry><cylinder><radius>$radius</radius><length>$body_height</length></cylinder></geometry>
        <material>
          <ambient>0.80 0.15 0.15 1</ambient>
          <diffuse>0.80 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <visual name="head_visual">
        <pose>0 0 $head_z 0 0 0</pose>
        <geometry><sphere><radius>$head_radius</radius></sphere></geometry>
        <material>
          <ambient>0.90 0.72 0.58 1</ambient>
          <diffuse>0.90 0.72 0.58 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
